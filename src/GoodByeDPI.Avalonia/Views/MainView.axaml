<UserControl x:Class="GoodByeDPI.Avalonia.Views.MainView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dialogs="clr-namespace:SukiUI.Dialogs;assembly=SukiUI"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:services="clr-namespace:GoodByeDPI.Avalonia.Services"
             xmlns:sukiUi="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             xmlns:vm="using:GoodByeDPI.Core.ViewModels"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:DataType="vm:MainViewModel"
             DataContext="{services:ServiceResolver Type=vm:MainViewModel}"
             mc:Ignorable="d">
    <Panel>
        <sukiUi:SukiTransitioningContentControl Content="{Binding Navigation.Current}" />
        <sukiUi:SukiDialogHost Manager="{services:ServiceResolver Type=dialogs:ISukiDialogManager}" />
    </Panel>
</UserControl>