<UserControl x:Class="GoodByeDPI.Avalonia.Views.MainView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sukiUi="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             xmlns:ui="clr-namespace:GoodByeDPI.Avalonia"
             xmlns:vm="using:GoodByeDPI.Core.ViewModels"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:DataType="vm:MainViewModel"
             mc:Ignorable="d">
    <Design.DataContext>
        <ui:DesignServiceLocator Type="vm:MainViewModel" />
    </Design.DataContext>

    <Panel>
        <sukiUi:SukiTransitioningContentControl Content="{Binding Navigation.Current}" />
        <sukiUi:SukiDialogHost x:Name="DialogHost" />
    </Panel>
</UserControl>